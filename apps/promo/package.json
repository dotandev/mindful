{
  "name": "@mindfulverse/promo",
  "version": "0.0.0",
  "private": true,
  "description": "Motion promos for MindfulVerse, rendered with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HeartPromo out/heart-promo.mp4",
    "still": "remotion still src/index.ts HeartPromo out/still.png",
    "render:silent": "remotion render src/index.ts HeartPromoSilent out/heart-promo-silent.mp4",
    "capture": "node scripts/capture-screens.mjs",
    "render:day": "remotion render src/index.ts DayInTheLife out/day-in-the-life.mp4",
    "capture:whatsnew": "node scripts/capture-whatsnew.mjs",
    "render:whatsnew": "remotion render src/index.ts WhatsNew out/whats-new.mp4",
    "render:whatsnew:silent": "remotion render src/index.ts WhatsNewSilent out/whats-new-silent.mp4",
    "capture:three": "node scripts/capture-three.mjs",
    "render:onesurah": "remotion render src/index.ts OneSurahOneWeek out/one-surah-one-week.mp4",
    "render:onesurah:silent": "remotion render src/index.ts OneSurahOneWeekSilent out/one-surah-one-week-silent.mp4",
    "render:stand": "remotion render src/index.ts StandLoop out/stand-loop-landscape.mp4",
    "render:stand:vertical": "remotion render src/index.ts StandLoopVertical out/stand-loop-vertical.mp4",
    "render:circle": "remotion render src/index.ts StartACircle out/start-a-circle.mp4",
    "render:circle:silent": "remotion render src/index.ts StartACircleSilent out/start-a-circle-silent.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.534"
  }
}
